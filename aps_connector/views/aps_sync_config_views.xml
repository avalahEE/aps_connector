<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- APS Sync Config Form View -->
    <record id="view_aps_sync_config_form" model="ir.ui.view">
        <field name="name">aps.sync.config.form</field>
        <field name="model">aps.sync.config</field>
        <field name="arch" type="xml">
            <form string="APS Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Configuration Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="api_key_display" password="True"/>
                            <field name="odoo_version" readonly="1"/>
                        </group>
                        <group string="Organization">
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- APS Sync Config Tree View -->
    <record id="view_aps_sync_config_tree" model="ir.ui.view">
        <field name="name">aps.sync.config.tree</field>
        <field name="model">aps.sync.config</field>
        <field name="arch" type="xml">
            <tree string="APS Configurations">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- APS Sync Config Action -->
    <record id="action_aps_sync_config" model="ir.actions.act_window">
        <field name="name">APS Settings</field>
        <field name="res_model">aps.sync.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure APS Integration
            </p>
            <p>
                Set up connection to the Advanced Planning and Scheduling system.
            </p>
        </field>
    </record>
</odoo>
